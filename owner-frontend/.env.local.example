# ---------------------------------------------------------------------------
# Clerk  (Dashboard -> API keys)
# ---------------------------------------------------------------------------
# The same Clerk instance as the player app: one account holds every role, so an
# owner who is also a player signs in once (CLAUDE.md, "Roles are permissions on one
# account, never separate user types").
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# NEXT_PUBLIC_CLERK_SIGN_IN_URL and the three beside it are deliberately NOT here any
# more. They are routes, not deployment configuration, and keeping them in an env file
# meant local development had them and production did not: the Phase 13 Vercel table
# never listed them, an empty Clerk URL is not an error, and the deployed app quietly
# used the Dashboard's answers instead — sign-in on the hosted account portal, and the
# *player* app as the place an owner lands after signing in. They live in
# `src/lib/clerk-routes.ts` now, which both `app/layout.tsx` and `src/proxy.ts` read.

# ---------------------------------------------------------------------------
# Django API
# ---------------------------------------------------------------------------
# Origin only: the generated schema's paths already include /api/v1.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Used by `npm run gen:api`.
NEXT_PUBLIC_API_SCHEMA_URL=http://127.0.0.1:8000/api/v1/schema/

# Public origin of this deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# The player app, for the crossings between the two: a turf's public page, and the
# policy documents in the footer.
NEXT_PUBLIC_PLAYER_APP_URL=http://localhost:3000

# Error reporting. Empty means nothing is initialised and nothing is sent.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
