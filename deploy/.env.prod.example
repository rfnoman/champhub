# Every variable the live backend reads, with no values (Phase 13 step 7).
#
# The real file is /opt/champhub/deploy/.env.prod on the droplet, chmod 600, and is
# never committed. Secrets belong there and in nothing else — not in this repo, not in
# chat, not in the DigitalOcean console's env UI.

DJANGO_SETTINGS_MODULE=config.settings.prod
# `python -c "import secrets; print(secrets.token_urlsafe(64))"` on the droplet.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=api.champhub.fit
DJANGO_LOG_LEVEL=INFO

# --- Database: DigitalOcean Managed PostgreSQL ------------------------------
# POSTGRES_PORT is the PgBouncer pool. deploy.sh and backup.sh override it with
# POSTGRES_DIRECT_PORT: DDL and pg_dump do not belong behind a transaction-mode pooler.
POSTGRES_DB=champhub
POSTGRES_USER=champhub
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DIRECT_PORT=25060
POSTGRES_SSLMODE=require
# PgBouncer is the pool; a client pool in every process on top of it only holds more of
# the cluster's two dozen connections.
POSTGRES_POOL=false
POSTGRES_CONN_MAX_AGE=0
POSTGRES_BEHIND_PGBOUNCER=true

# --- Redis (in this compose project, never published to the host) -----------
REDIS_URL=redis://redis:6379/0

# --- Origins ----------------------------------------------------------------
# Leaving one out of CLERK_AUTHORIZED_PARTIES is a 401 on every call from that app with
# nothing in the log but "Unauthorized" (D85). That includes www.
CORS_ALLOWED_ORIGINS=https://champhub.fit,https://www.champhub.fit,https://turf.champhub.fit
CSRF_TRUSTED_ORIGINS=https://champhub.fit,https://www.champhub.fit,https://turf.champhub.fit
CLERK_AUTHORIZED_PARTIES=https://champhub.fit,https://www.champhub.fit,https://turf.champhub.fit
API_PUBLIC_BASE_URL=https://api.champhub.fit
PAYMENT_RETURN_BASE_URL=https://champhub.fit
OWNER_APP_BASE_URL=https://turf.champhub.fit

# --- Clerk (production instance) --------------------------------------------
CLERK_FRONTEND_API_URL=https://clerk.champhub.fit
CLERK_ISSUER=https://clerk.champhub.fit
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Media: DigitalOcean Spaces (S3-compatible) -----------------------------
# Spaces and not R2: identity documents live under the bucket's `private/` prefix with
# a private per-object ACL, and R2 has no per-object ACLs (D89).
AWS_STORAGE_BUCKET_NAME=champhub-media
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Email ------------------------------------------------------------------
# Console until an SMTP provider is set up: Django's notification emails are logged
# rather than sent. Clerk sends its own sign-in and verification mail either way, so
# sign-up works without this.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ChampHub <no-reply@champhub.fit>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# --- Web push (Phase 09). Unset means push is simply off. -------------------
# `manage.py generate_vapid_keys`, run on the droplet.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=

# --- Payments ---------------------------------------------------------------
# Sandbox until step 9 passes end to end; SSLCommerz's refund API also needs the
# droplet's reserved IP registered with them.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# --- Observability ----------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- Security ---------------------------------------------------------------
ADMIN_REQUIRES_OTP=true
API_DOCS_PUBLIC=false

# --- Process sizing ---------------------------------------------------------
# Gunicorn workers. 2 if a 2 GB box starts swapping.
WEB_CONCURRENCY=3
# Caddy is the one hop in front of gunicorn that is allowed to name the client.
DRF_NUM_PROXIES=1

# --- Off-provider backups (deploy/backup.sh) --------------------------------
BACKUP_BUCKET=champhub-backups
BACKUP_KEEP=8
