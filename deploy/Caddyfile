# TLS terminator and the only container with public ports (Phase 13 step 4).
#
# Cloudflare proxies api.champhub.fit, so every request arrives from a Cloudflare
# address over an origin certificate Cloudflare issued (SSL/TLS mode Full (strict)).
# That certificate is valid for 15 years and is not a public one: only Cloudflare
# accepts it, which is the point — a request that reaches this box without going
# through Cloudflare cannot complete a handshake.
{
	# Who may speak for the client. Without this, `client_ip` is the direct peer —
	# Cloudflare — and anyone could set CF-Connecting-IP to anything they liked.
	# Refresh from https://www.cloudflare.com/ips-v4 and -v6 (they change rarely;
	# last taken 2026-11-21).
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers Cf-Connecting-Ip
	}
	admin off
	email ops@champhub.fit
}

api.champhub.fit {
	tls /certs/origin.pem /certs/origin.key
	encode gzip

	log {
		output stdout
		format json
	}

	reverse_proxy api:8000 {
		# The notification stream is a long-lived response (D54). Buffering it would
		# hold every event until the buffer filled, which is never.
		flush_interval -1
		header_up X-Forwarded-Proto https
		# Exactly one address, the real client's: DRF's NUM_PROXIES=1 reads the last
		# entry of this header, and the default behaviour would leave Cloudflare's
		# address there — one throttle bucket for the whole country (step 0.2).
		header_up X-Forwarded-For {http.request.client_ip}
	}
}

# Port 80 on the origin. Cloudflare has "Always Use HTTPS" on, so a browser's plain
# HTTP request is redirected at the edge and never arrives here; what does arrive is a
# scanner on the bare IP, which the cloud firewall should already have dropped. Answer
# a redirect rather than a 404 anyway: this block replaces Caddy's own automatic
# HTTP→HTTPS redirect (defining `:80` takes the port over), and a 404 would be the
# wrong answer for the one case that matters — a client that reaches the origin on 80
# for a host we do serve.
:80 {
	redir https://{host}{uri} permanent
}
